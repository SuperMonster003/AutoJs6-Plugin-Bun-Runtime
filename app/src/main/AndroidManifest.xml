<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Scripts run under the plugin's own uid, so its node:fs and Bun.write cannot use the host's
         grants. Only the user can turn on "All files access" for this plugin in system settings;
         the host offers that page after EACCES on shared storage (AutoJs6 api-coverage Q228). -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="org.autojs.permission.PLUGIN" />
    <permission android:name="org.autojs.permission.BUN_PACKAGED_RUNTIME" android:protectionLevel="normal" />
    <uses-permission android:name="org.autojs.permission.BUN_PACKAGED_RUNTIME" />

    <!-- M7 host info snapshot: the runtime resolves the calling host's version from PackageManager instead of trusting the request. -->
    <queries>
        <package android:name="org.autojs.autojs6" />
    </queries>

    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_icon_studio_application"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:roundIcon="@mipmap/ic_icon_studio_application">

        <meta-data
            android:name="org.autojs.plugin.contract.NATIVE_PAGE_ALIGNMENT"
            android:value="16384" />

        <meta-data
            android:name="org.autojs.plugin.WAKE_ACTIVITY"
            android:value=".WakeActivity" />
        <meta-data
            android:name="org.autojs.plugin.info.AUTHOR"
            android:value="@string/plugin_author" />

        <activity
            android:name=".LocalNetworkPermissionActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name=".WakeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:finishOnTaskLaunch="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="org.autojs.plugin.action.WAKE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".BunPluginInfoService"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN">
            <intent-filter>
                <action android:name="org.autojs.plugin.INFO" />
                <category android:name="bun" />
            </intent-filter>
        </service>

        <service
            android:name=".BunRuntimeService"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:process=":bun_runtime">
            <intent-filter>
                <action android:name="org.autojs.plugin.bun.RUNTIME" />
                <category android:name="bun" />
            </intent-filter>
        </service>

        <service
            android:name=".BunPackagedRuntimeService"
            android:exported="true"
            android:permission="org.autojs.permission.BUN_PACKAGED_RUNTIME"
            android:process=":bun_packaged_runtime">
            <intent-filter>
                <action android:name="org.autojs.plugin.bun.PACKAGED_RUNTIME" />
                <category android:name="bun" />
            </intent-filter>
        </service>

    </application>

</manifest>
