 src/sys/linux_syscall.rs | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/src/sys/linux_syscall.rs b/src/sys/linux_syscall.rs
index ae5cc0041722e39939949fa083eeab55bc91dac3..01eb4d017a0fcfccbe69a39c7ea725a5d3b37813 100644
