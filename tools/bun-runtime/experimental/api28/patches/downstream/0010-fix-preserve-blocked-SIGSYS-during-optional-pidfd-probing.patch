 /// `pidfd_open(2)` — `Result` shape (caller maps to `bun_sys::Error`).
 #[inline]
 #[cfg(target_os = "linux")]
 pub(crate) fn pidfd_open(pid: i32, flags: u32) -> Result<Fd, i32> {
     let pid = rustix::process::Pid::from_raw(pid).ok_or(libc::EINVAL)?;
     let flags = rustix::process::PidfdFlags::from_bits_retain(flags);
     once(rustix::process::pidfd_open(pid, flags)).map(own_fd)
 }
 /// Android: rustix 0.38 gates `process::pidfd_open` behind
 /// `cfg(target_os = "linux")`, but the kernel ABI is identical (same generic
 /// syscall number 434 since Linux 5.3, before any Android NDK target shipped).
 /// Raw-syscall it like the other shims here.
 #[inline]
 #[cfg(target_os = "android")]
 pub(crate) fn pidfd_open(pid: i32, flags: u32) -> Result<Fd, i32> {
     if pid <= 0 {
         return Err(libc::EINVAL);
     }
+    // Android app seccomp can turn this optional probe into SIGSYS, even on a
+    // kernel without pidfd_open. A blocked synchronous SIGSYS cannot reach
+    // our ENOSYS handler. Keep the caller's mask and pending signals intact:
+    // select the existing waiter-thread fallback instead of unblocking it.
+    let mut mask = core::mem::MaybeUninit::<libc::sigset_t>::uninit();
+    // SAFETY: a null set only queries this thread's mask; mask is writable.
+    let error = unsafe { libc::pthread_sigmask(libc::SIG_BLOCK, core::ptr::null(), mask.as_mut_ptr()) };
+    if error != 0 {
+        return Err(error);
+    }
+    // SAFETY: pthread_sigmask initialized mask on success; SIGSYS is valid.
+    let blocked = unsafe { libc::sigismember(mask.as_ptr(), libc::SIGSYS) };
+    match blocked {
+        0 => {}
+        1 => return Err(libc::ENOSYS),
+        // Do not issue a potentially fatal probe if the query was invalid.
+        _ => return Err(libc::EINVAL),
+    }
+
     // libc 0.2.x doesn't expose `SYS_pidfd_open` for Android either, so use
     // the kernel constant. `pidfd_open` has the same number on every arch.
     const SYS_PIDFD_OPEN: libc::c_long = 434;
     // SAFETY: raw `pidfd_open(2)`; kernel validates pid/flags.
     let rc = unsafe { libc::syscall(SYS_PIDFD_OPEN, pid, flags) };
     if rc < 0 {
         return Err(errno());
     }
     Ok(Fd::from_native(rc as i32))
 }
 
