Date: Thu, 10 Sep 2026 12:00:00 +0800
Subject: [PATCH] fix: enumerate live spawn fds without allocating in the vfork
 child

---
 src/jsc/bindings/bun-spawn-fd.h | 129 ++++++++++++++++++++++++++++++++
 src/jsc/bindings/bun-spawn.cpp  |  24 +++---
 2 files changed, 144 insertions(+), 9 deletions(-)
 create mode 100644 src/jsc/bindings/bun-spawn-fd.h

diff --git a/src/jsc/bindings/bun-spawn-fd.h b/src/jsc/bindings/bun-spawn-fd.h
new file mode 100644
index 0000000000000000000000000000000000000000..34444285ab151464767e13893ce0c7ae618ae969
--- /dev/null
+++ b/src/jsc/bindings/bun-spawn-fd.h
@@ -0,0 +1,129 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+// Linux vfork child only: no allocator, libc directory stream or shared fd table.
+static inline long bun_spawn_retry_syscall(long number, long a, long b, long c = 0, long d = 0)
+{
+    long result;
+    unsigned retries = 0;
+    do {
+        result = syscall(number, a, b, c, d);
+    } while (result < 0 && errno == EINTR && retries++ < 8);
+    return result;
+}
+
+struct BunSpawnDirent64 {
+    uint64_t ino;
+    int64_t offset;
+    uint16_t length;
+    uint8_t type;
+    char name[1];
+};
+static_assert(offsetof(BunSpawnDirent64, name) == 19);
+
+// Enumerate actual fds: even the hard limit can be lowered below an open fd.
+static inline int bun_spawn_fd_fallback(int first, int last, bool cloexec)
+{
+    if (first < 0 || last < first) {
+        errno = EINVAL;
+        return -1;
+    }
+    int directory = static_cast<int>(bun_spawn_retry_syscall(SYS_openat, AT_FDCWD,
+        reinterpret_cast<long>("/proc/self/fd"), O_RDONLY | O_DIRECTORY | O_CLOEXEC, 0));
+    if (directory < 0)
+        return -1;
+
+    int error = 0;
+    unsigned entries = 0;
+    constexpr unsigned entryLimit = 1048576;
+    constexpr size_t nameOffset = offsetof(BunSpawnDirent64, name);
+    alignas(BunSpawnDirent64) unsigned char buffer[4096];
+    while (!error) {
+        long count = bun_spawn_retry_syscall(SYS_getdents64, directory, reinterpret_cast<long>(buffer), sizeof(buffer));
+        if (count < 0) {
+            error = errno;
+            break;
+        }
+        if (count == 0)
+            break;
+        if (static_cast<unsigned long>(count) > sizeof(buffer)) {
+            error = EIO;
+            break;
+        }
+        size_t position = 0;
+        while (position < static_cast<size_t>(count)) {
+            if (static_cast<size_t>(count) - position < nameOffset + 1) {
+                error = EIO;
+                break;
+            }
+            const auto* entry = reinterpret_cast<const BunSpawnDirent64*>(buffer + position);
+            size_t length = entry->length;
+            if (length < nameOffset + 1 || length % alignof(BunSpawnDirent64)
+                || length > static_cast<size_t>(count) - position) {
+                error = EIO;
+                break;
+            }
+            if (entries++ == entryLimit) {
+                error = E2BIG;
+                break;
+            }
+            size_t nameLength = 0;
+            const char* name = reinterpret_cast<const char*>(buffer + position + nameOffset);
+            while (nameLength < length - nameOffset && name[nameLength])
+                ++nameLength;
+            if (nameLength == 0 || nameLength == length - nameOffset) {
+                error = EIO;
+                break;
+            }
+            if (!(nameLength == 1 && name[0] == '.') && !(nameLength == 2 && name[0] == '.' && name[1] == '.')) {
+                unsigned fd = 0;
+                for (size_t i = 0; i < nameLength; ++i) {
+                    if (name[i] < '0' || name[i] > '9') {
+                        error = EIO;
+                        break;
+                    }
+                    unsigned digit = static_cast<unsigned>(name[i] - '0');
+                    if (fd > (static_cast<unsigned>(INT_MAX) - digit) / 10) {
+                        error = EOVERFLOW;
+                        break;
+                    }
+                    fd = fd * 10 + digit;
+                }
+                if (error)
+                    break;
+                if (fd != static_cast<unsigned>(directory) && fd >= static_cast<unsigned>(first) && fd <= static_cast<unsigned>(last)) {
+                    if (cloexec) {
+                        long flags = bun_spawn_retry_syscall(SYS_fcntl, fd, F_GETFD);
+                        if (flags < 0) {
+                            if (errno != EBADF)
+                                error = errno;
+                        } else if (!(flags & FD_CLOEXEC) && bun_spawn_retry_syscall(SYS_fcntl, fd, F_SETFD, flags | FD_CLOEXEC) < 0 && errno != EBADF) {
+                            error = errno;
+                        }
+                    } else if (syscall(SYS_close, static_cast<long>(fd)) < 0 && errno != EBADF) {
+                        error = errno;
+                    }
+                    if (error)
+                        break;
+                }
+            }
+            position += length;
+        }
+    }
+    // Linux releases a close() fd even on EINTR; never retry a reused number.
+    if (syscall(SYS_close, static_cast<long>(directory)) < 0 && !error)
+        error = errno;
+    if (error) {
+        errno = error;
+        return -1;
+    }
+    return 0;
+}
