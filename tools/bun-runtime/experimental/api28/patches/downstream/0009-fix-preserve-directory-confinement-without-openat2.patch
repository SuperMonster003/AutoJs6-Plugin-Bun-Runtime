index 0000000000000000000000000000000000000000..126e7bd1e89094d238b444af9b9cd73c1babf899
--- /dev/null
+++ b/src/jsc/bindings/bun-scoped-open.h
@@ -0,0 +1,175 @@
+// SPDX-License-Identifier: MIT
+// Read-only directory-route fallback, not a general openat2 implementation.
+#pragma once
+#include <cerrno>
+#include <cstddef>
+#include <cstdio>
+#include <cstring>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <sys/vfs.h>
+#include <unistd.h>
+
+namespace BunScopedOpen {
+constexpr size_t pathLimit = 4096;
+constexpr size_t depthLimit = pathLimit / 2 + 1;
+constexpr unsigned linkLimit = 40;
+constexpr unsigned stepLimit = 8192;
+constexpr long procMagic = 0x9fa0;
+
+struct LinuxOps {
+    static int open(int dir, const char* path, int flags) { return ::openat(dir, path, flags, 0); }
+    static int stat(int fd, struct stat* st) { return ::fstat(fd, st); }
+    static int fsstat(int fd, struct statfs* st) { return ::fstatfs(fd, st); }
+    static ssize_t link(int fd, char* bytes, size_t size) { return ::readlinkat(fd, "", bytes, size); }
+    static int close(int fd) { return ::close(fd); }
+};
+
+template<typename F> inline auto retry(F call)
+{
+    decltype(call()) result;
+    unsigned interrupted = 0;
+    do {
+        result = call();
+    } while (result < 0 && errno == EINTR && interrupted++ < 8);
+    return result;
+}
+
+inline int error(int code) { errno = code; return -1; }
+inline bool same(const struct stat& a, const struct stat& b)
+{
+    return a.st_dev == b.st_dev && a.st_ino == b.st_ino && (a.st_mode & S_IFMT) == (b.st_mode & S_IFMT);
+}
+
+template<typename Ops> struct OwnedFd {
+    int value;
+    explicit OwnedFd(int fd = -1) : value(fd) { }
+    OwnedFd(const OwnedFd&) = delete;
+    OwnedFd& operator=(const OwnedFd&) = delete;
+    ~OwnedFd()
+    {
+        const int saved = errno;
+        if (value >= 0) Ops::close(value); // Never retry close after EINTR.
+        errno = saved;
+    }
+    int take() { const int fd = value; value = -1; return fd; }
+};
+
+template<typename Ops> struct Walk {
+    int dirs[depthLimit];
+    size_t depth = 0;
+    Walk() = default;
+    Walk(const Walk&) = delete;
+    Walk& operator=(const Walk&) = delete;
+    ~Walk() { while (depth) pop(); }
+    void pop()
+    {
+        const int saved = errno;
+        Ops::close(dirs[--depth]);
+        errno = saved;
+    }
+    // Detect a pinned directory moved away from its pinned parent. Never use
+    // the filesystem's mutable '..' to implement user-controlled traversal.
+    bool unchanged()
+    {
+        for (size_t i = depth; i > 1; --i) {
+            OwnedFd<Ops> parent(retry([&] { return Ops::open(dirs[i - 1], "..", O_PATH | O_DIRECTORY | O_CLOEXEC); }));
+            struct stat actual, expected;
+            if (parent.value < 0 || retry([&] { return Ops::stat(parent.value, &actual); }) < 0
+                || retry([&] { return Ops::stat(dirs[i - 2], &expected); }) < 0)
+                return false;
+            if (!same(actual, expected)) { error(EAGAIN); return false; }
+        }
+        return true;
+    }
+};
+
+template<typename Ops> int reopen(int pinned, int flags, Walk<Ops>& walk)
+{
+    struct stat before, after;
+    if (retry([&] { return Ops::stat(pinned, &before); }) < 0) return -1;
+    // DirectoryRoute only serves regular files/directories. Do not activate
+    // devices, sockets or FIFOs while finding out that they cannot be served.
+    if (!S_ISREG(before.st_mode) && !S_ISDIR(before.st_mode)) return error(EOPNOTSUPP);
+    if ((flags & O_DIRECTORY) && !S_ISDIR(before.st_mode)) return error(ENOTDIR);
+    if (!walk.unchanged()) return -1;
+    OwnedFd<Ops> proc(retry([&] { return Ops::open(AT_FDCWD, "/proc/self/fd", O_PATH | O_DIRECTORY | O_CLOEXEC); }));
+    struct statfs fs;
+    if (proc.value < 0 || retry([&] { return Ops::fsstat(proc.value, &fs); }) < 0) return -1;
+    if (fs.f_type != procMagic) return error(EOPNOTSUPP);
+    char name[32];
+    const int length = snprintf(name, sizeof(name), "%d", pinned);
+    if (length <= 0 || static_cast<size_t>(length) >= sizeof(name)) return error(EOVERFLOW);
+    // This is an internally owned, still-open descriptor, not a user path.
+    // Reopening the original name would reintroduce a final-component race.
+    OwnedFd<Ops> result(retry([&] { return Ops::open(proc.value, name, flags | O_CLOEXEC | O_NONBLOCK); }));
+    if (result.value < 0 || retry([&] { return Ops::stat(result.value, &after); }) < 0) return -1;
+    if (!same(before, after)) return error(EAGAIN);
+    if (!walk.unchanged()) return -1;
+    return result.take();
+}
+
+template<typename Ops = LinuxOps> int resolve(int root, const char* path, int flags, unsigned mode)
+{
+    // This helper has exactly one read-only DirectoryRoute caller. Do not
+    // silently approximate create/write/truncate or unrelated resolve flags.
+    if (root < 0) return error(EBADF);
+    if (!path || mode || (flags & ~(O_CLOEXEC | O_NONBLOCK | O_DIRECTORY))) return error(EINVAL);
+    const size_t initial = strnlen(path, pathLimit);
+    if (!initial) return error(ENOENT);
+    if (initial >= pathLimit) return error(ENAMETOOLONG);
+    char pending[pathLimit], target[pathLimit], component[256];
+    memcpy(pending, path, initial + 1);
+    Walk<Ops> walk;
+    const int rootCopy = retry([&] { return Ops::open(root, ".", O_PATH | O_DIRECTORY | O_CLOEXEC); });
+    if (rootCopy < 0) return -1;
+    walk.dirs[walk.depth++] = rootCopy;
+    unsigned links = 0, steps = 0;
+    size_t cursor = 0;
+    for (;;) {
+        if (++steps > stepLimit) return error(ELOOP);
+        while (pending[cursor] == '/') ++cursor;
+        if (!pending[cursor]) return reopen<Ops>(walk.dirs[walk.depth - 1], flags, walk);
+        const size_t start = cursor;
+        while (pending[cursor] && pending[cursor] != '/') ++cursor;
+        const size_t length = cursor - start;
+        if (length >= sizeof(component)) return error(ENAMETOOLONG);
+        memcpy(component, pending + start, length); component[length] = 0;
+        if (!strcmp(component, ".")) continue;
+        if (!strcmp(component, "..")) {
+            if (!walk.unchanged()) return -1;
+            if (walk.depth > 1) walk.pop(); // Clamp at the saved root.
+            continue;
+        }
+        OwnedFd<Ops> child(retry([&] { return Ops::open(walk.dirs[walk.depth - 1], component, O_PATH | O_NOFOLLOW | O_CLOEXEC); }));
+        struct stat st;
+        if (child.value < 0 || retry([&] { return Ops::stat(child.value, &st); }) < 0) return -1;
+        if (S_ISLNK(st.st_mode)) {
+            if (++links > linkLimit) return error(ELOOP);
+            struct statfs fs;
+            if (retry([&] { return Ops::fsstat(child.value, &fs); }) < 0) return -1;
+            // Conservatively reject procfs links (including magic links).
+            // The kernel never follows a user-supplied link in this walk.
+            if (fs.f_type == procMagic) return error(ELOOP);
+            const ssize_t size = retry([&] { return Ops::link(child.value, target, sizeof(target)); });
+            if (size < 0) return -1;
+            if (!size) return error(ENOENT);
+            if (static_cast<size_t>(size) >= sizeof(target)) return error(ENAMETOOLONG);
+            const size_t rest = strlen(pending + cursor);
+            if (static_cast<size_t>(size) + rest >= sizeof(pending)) return error(ENAMETOOLONG);
+            memmove(pending + size, pending + cursor, rest + 1);
+            memcpy(pending, target, size);
+            if (target[0] == '/') while (walk.depth > 1) walk.pop();
+            cursor = 0;
+            continue;
+        }
+        if (pending[cursor] == '/') {
+            if (!S_ISDIR(st.st_mode)) return error(ENOTDIR);
+            if (walk.depth >= depthLimit) return error(ENAMETOOLONG);
+            walk.dirs[walk.depth++] = child.take();
+            continue;
+        }
+        return reopen<Ops>(child.value, flags, walk);
+    }
+}
+} // namespace BunScopedOpen
